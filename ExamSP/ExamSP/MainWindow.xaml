<Window x:Class="ExamSP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamSP"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label VerticalAlignment="Center">Directory:</Label>
            <TextBox Name="dirTextBox" Text="F:\examdirestorytest" Margin="5" Padding="5" Grid.Column="1"></TextBox>
            <Label Grid.Row="1" VerticalAlignment="Center">Word:</Label>
            <TextBox Name="wordTextBox" Margin="5" Padding="5" Grid.Row="1" Grid.Column="1"></TextBox>
        </Grid>
        <Button Name="searchButton" DockPanel.Dock="Top" Padding="10" Margin="5" Click="SearchButtonClick">Search</Button>
        <ProgressBar Name="progress" DockPanel.Dock="Bottom" Height="30"></ProgressBar>
        <TextBox Name="resultTextBox" Margin="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto"></TextBox>
    </DockPanel>
</Window>